# Copy to .env. Never commit .env or your actual key.
PARSE_API_KEY=
# The UUID in your Parse endpoint URL: /scraper/THIS_ID/list_settlements
PARSE_SCRAPER_ID=

# With Compose this selects the host port; the container always uses 8765.
SETTLEMENT_PORT=8765
# Native Python only. Compose uses its persistent named volume instead.
SETTLEMENT_DB=data/settlements.sqlite3
# Optional public sample data, imported only when creating a new database.
SETTLEMENT_LOAD_SAMPLE=false
